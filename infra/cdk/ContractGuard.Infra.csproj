<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.277.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- cdk.out holds a copy of the repo for the API image; a second synth run (after a lookup) must not compile it. -->
    <Compile Remove="cdk.out/**" />
  </ItemGroup>

</Project>
