{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractguard.local/contracts/extraction.v2.schema.json",
  "title": "ContractGuard AI extraction v2 (DRAFT, needs AI + IA + SE review)",
  "description": "Written by the worker to s3://<bucket>/results/{job_id}/extraction.json. Untrusted: the backend validates it against this schema, then checks clause ids, quotes and page numbers against the clauses before saving anything. Changes from v1: adds document, clauses, findings, checks, metadata, injection_warnings, trace (SD-10); drops 'context' because the backend owns the trusted context and sends it in the job request. 2026-11-21: dropped tenant_id, output_language, document.is_scanned and embeddings, which the backend never used (it sends tenant and language in the request; chat goes through the worker, docs/04 C6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "contract_id",
    "contract_version",
    "document_complete",
    "document",
    "clauses",
    "findings",
    "checks",
    "facts",
    "trace"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "job_id": { "$ref": "#/$defs/nonEmptyString", "description": "Copied from the job request. The backend ignores it if it differs from the message job_id." },
    "contract_id": { "$ref": "#/$defs/nonEmptyString" },
    "contract_version": { "$ref": "#/$defs/nonEmptyString" },
    "document_complete": {
      "type": "boolean",
      "description": "false when part of the document could not be read; 'missing clause' findings are then not conclusive."
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_type", "page_count", "language"],
      "properties": {
        "file_type": { "enum": ["pdf", "docx"], "description": "Real file type detected from content, not from the extension." },
        "page_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "clean_file_key": { "type": "string", "pattern": "^clean/", "description": "Where the worker stored the sanitized file (SD-07)." },
        "language": { "enum": ["vi", "en", "mixed"] }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "order", "number", "text", "clause_type", "location"],
        "properties": {
          "clause_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "order": { "type": "integer", "minimum": 1 },
          "number": { "type": "string", "maxLength": 50, "description": "Numbering as printed, e.g. '5.2' or 'Điều 7'. Empty string when none." },
          "heading": { "type": ["string", "null"], "maxLength": 500 },
          "text": { "$ref": "#/$defs/nonEmptyString", "description": "Verbatim clause text." },
          "clause_type": { "type": "string", "pattern": "^C(0[1-9]|1[0-9]|2[01]|99)$", "description": "BR-RISK-006" },
          "location": { "$ref": "#/$defs/location" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "F-CTR-002. Every field may be null when not found.",
      "properties": {
        "parties": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "contract_type": { "enum": ["service_agreement", "vendor_agreement", "purchase_agreement", "msa", "sow", "other", null] },
        "contract_value": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "expiry_date": { "type": ["string", "null"], "format": "date" },
        "governing_law": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "finding_kind", "title", "primary_domain", "severity", "why", "impact", "recommendation"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "finding_kind": { "enum": ["problematic_clause", "missing_clause"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "primary_domain": { "$ref": "#/$defs/domain" },
          "secondary_domains": { "type": "array", "items": { "$ref": "#/$defs/domain" }, "uniqueItems": true },
          "category": { "type": ["string", "null"], "maxLength": 200, "description": "Category inside the domain (BR-RISK-014)." },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "clause_id": { "type": ["string", "null"], "description": "Required for problematic_clause, null for missing_clause." },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" },
            "description": "Verbatim quotes. Required (min 1) for problematic_clause (BR-RISK-013)."
          },
          "missing_description": { "type": ["string", "null"], "description": "For missing_clause: what was searched for and not found (BR-RISK-013)." },
          "why": { "$ref": "#/$defs/nonEmptyString" },
          "impact": { "$ref": "#/$defs/nonEmptyString" },
          "recommendation": { "$ref": "#/$defs/nonEmptyString", "description": "Direction in words, not replacement wording." },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "reference_number"],
              "properties": {
                "source": { "$ref": "#/$defs/nonEmptyString" },
                "reference_number": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          },
          "check_code": { "anyOf": [{ "$ref": "#/$defs/checkCode" }, { "type": "null" }], "description": "Set when the finding comes from a PARTIAL or MISSING check." }
        },
        "allOf": [
          {
            "if": { "properties": { "finding_kind": { "const": "problematic_clause" } } },
            "then": { "required": ["clause_id", "evidence"], "properties": { "clause_id": { "type": "string" }, "evidence": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "finding_kind": { "const": "missing_clause" } } },
            "then": { "required": ["missing_description"], "properties": { "missing_description": { "type": "string", "minLength": 1 } } }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "description": "Exactly the 20 checks of BR-RISK-007, each once.",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_code", "check_status"],
        "properties": {
          "check_code": { "$ref": "#/$defs/checkCode" },
          "check_status": { "enum": ["pass", "partial", "missing", "not_applicable"] },
          "clause_ids": { "type": "array", "items": { "type": "string" } },
          "finding_id": { "type": ["string", "null"], "description": "The finding generated by a partial or missing check." },
          "note": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "Normalized facts for the rule engine, same shape as v1 (security/rules/*.yaml fact_key).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "value", "evidence"],
        "properties": {
          "status": { "enum": ["FOUND", "NOT_FOUND", "UNKNOWN"] },
          "value": { "type": ["integer", "number", "string", "boolean", "null"] },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
        }
      }
    },
    "injection_warnings": {
      "type": "array",
      "description": "F-SEC-001: passages that look like instructions to the AI.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "excerpt"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/$defs/region" },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "overall_recommendation": { "type": ["string", "null"], "maxLength": 4000 },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version", "overall_score", "risk_level", "domains"],
      "description": "PROPOSED by SE 2026-11-10, pending AI + IA review (docs/06-ai-integration-points.md). F-RISK-003: computed by worker code, not by the model (docs/05 §4). Optional until agreed.",
      "properties": {
        "rule_version": { "$ref": "#/$defs/nonEmptyString", "description": "Version of the scoring config used (FR-ANA-016)." },
        "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "risk_level": { "$ref": "#/$defs/riskLevel" },
        "domains": {
          "type": "array",
          "description": "Exactly the 7 domains, each once. N/A domains have no score (BR-RISK-003).",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "applicable"],
            "properties": {
              "domain": { "$ref": "#/$defs/domain" },
              "applicable": { "type": "boolean" },
              "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
              "risk_level": { "anyOf": [{ "$ref": "#/$defs/riskLevel" }, { "type": "null" }] },
              "na_reason": { "type": ["string", "null"], "maxLength": 1000, "description": "Required when applicable is false (FR-VIEW-003)." },
              "re_enabled": { "type": "boolean", "description": "BR-RISK-004: N/A by context but turned back on because the contract has clauses of this domain." }
            }
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version", "prompt_version"],
      "description": "FR-ANA-016. rule_version travels in scoring.rule_version.",
      "properties": {
        "model_version": { "$ref": "#/$defs/nonEmptyString" },
        "prompt_version": { "$ref": "#/$defs/nonEmptyString" },
        "pipeline_version": { "type": "string" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["legal", "financial", "operational", "compliance", "cybersecurity", "data_privacy", "third_party"] },
    "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
    "checkCode": { "type": "string", "pattern": "^(CY-(0[1-9]|1[0-2])|PR-0[1-5]|TP-0[1-3])$" },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "x", "y", "width", "height"],
      "description": "Rectangle as fractions of the page size, origin top-left.",
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_start", "page_end", "regions"],
      "properties": {
        "page_start": { "type": "integer", "minimum": 1 },
        "page_end": { "type": "integer", "minimum": 1 },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "page", "quote"],
      "properties": {
        "clause_id": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
