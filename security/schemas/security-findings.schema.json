{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractGuard Security Rule Results v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "tenant_id",
    "contract_id",
    "policy_id",
    "policy_version",
    "rule_set_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "job_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "rule_set_version": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "domain",
          "status",
          "severity",
          "fact_key",
          "evidence",
          "reason"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE",
              "NEEDS_REVIEW"
            ]
          },
          "severity": {
            "enum": [
              "NONE",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "fact_key": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "clause_id",
                "page",
                "quote"
              ],
              "properties": {
                "clause_id": {
                  "type": "string"
                },
                "page": {
                  "type": "integer"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}