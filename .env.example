# Copy to .env and fill locally. Do not commit .env.
APP_ENV=development
AWS_REGION=ap-southeast-1
S3_BUCKET=
DATABASE_URL=

# Docker Compose (local dev)
# Free LocalStack Hobby token
LOCALSTACK_AUTH_TOKEN=

# true: confirming a context starts an analysis. Only for a worker, or scripts/dev/send-analysis-result.ps1.
# ANALYSIS_WORKER_ENABLED=true

# Google sign-in (F-AUTH-002): an OAuth client of type "Web application" in Google Cloud Console with
# redirect URI http://localhost:5173/api/v1/auth/google/callback. Empty: the button says it is not enabled.
# For `dotnet run`, set them with `dotnet user-secrets set Authentication:Google:ClientId ...` instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Mailpit ports on this machine, when another project already uses 1025 and 8025.
# MAILPIT_SMTP_PORT=11025
# MAILPIT_UI_PORT=18025
