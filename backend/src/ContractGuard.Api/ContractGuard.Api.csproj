<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContractGuard.Application\ContractGuard.Application.csproj" />
    <ProjectReference Include="..\ContractGuard.Infrastructure\ContractGuard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ContractGuard.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data of the development seed (DevSeeder): the synthetic contract and the result that matches it. -->
    <EmbeddedResource Include="..\..\..\contracts\examples\sample-contract.pdf" LogicalName="sample-contract.pdf" />
    <EmbeddedResource Include="..\..\..\contracts\examples\extraction.v2.example.json" LogicalName="extraction.v2.example.json" />
  </ItemGroup>

</Project>
