{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "BucketName": ""
  },
  "Queues": {
    "AnalysisRequests": "analysis-requests",
    "AnalysisResults": "analysis-results",
    "ChatRequests": "chat-requests",
    "AnalysisCancels": "analysis-cancels"
  },
  "Database": {
    "ConnectionString": ""
  },
  "Aws": {
    "Region": "ap-southeast-1"
  },
  "Analysis": {
    "WorkerEnabled": true
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "FromAddress": "",
    "FrontendBaseUrl": ""
  }
}
