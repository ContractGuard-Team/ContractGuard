# Docker builds use the repository root as context (backend/Dockerfile needs contracts/).
# Everything not needed by an image stays out: smaller context, faster builds, no secrets.
.git
.github
.vscode
.vs
.env
.env.*
**/bin
**/obj
**/node_modules
**/.venv
**/__pycache__
docs
RDK
AI
Idea
security
worker/out
real-contracts
test-reports
*.log
**/appsettings.*.local.json

# Not needed by any image built from the root (frontend builds from its own folder).
.claude
frontend
infra
