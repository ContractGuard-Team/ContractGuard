  "cards": [
    {
      "dot": "cyan",
      "title": "Luồng chính",
      "items": [
        "SPA xin presigned URL từ API rồi đẩy file thẳng lên S3; file lớn không đi qua service C#",
        "API tạo job, đẩy vào analysis-requests; worker parse, trích xuất, ghi extraction.json lên S3 và báo qua analysis-results",
        "BackgroundService của API validate schema, chấm điểm bằng rule engine, lưu finding vào PostgreSQL; UI gọi GET /jobs/{id} vài giây một lần"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ranh giới trách nhiệm",
      "items": [
        "Service C# là nơi duy nhất ghi database",
        "Worker Python không chứa business logic và không chạm database",
        "Thư mục /contracts chứa JSON Schema dùng chung cho hai bên"
      ]
    },
    {
      "dot": "violet",
      "title": "Bảo mật và vận hành",
      "items": [
        "S3 mã hóa SSE-KMS; secret trong Secrets Manager",
        "OpenTelemetry gửi sang CloudWatch và X-Ray, job_id là correlation ID",
        "Triển khai: AWS CDK (C#), GitHub Actions, ECR"
      ]
    },
    {
      "dot": "amber",
      "title": "Chưa chốt (xem docs/03-implementation-phases.md §4)",
      "items": [
        "D1: Cognito hay auth tự viết (khóa theo email, OTP email của SRS)",
        "D2: SES ra khỏi sandbox; D3, D4: chatbot gọi Bedrock và đọc pgvector ở đâu, streaming bằng gì",
        "D5: worker chạy sẵn hay scale từ 0"
      ]
    }
  ]
